<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_inherit_pos_associated_service" model="ir.ui.view">
        <field name="name">product.template.form.pos.associated.service</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="inside">
                <group string="Servicio asociado para POS" name="pos_associated_service_group">
                    <field name="x_has_associated_service"/>
                    <field
                        name="x_associated_service_id"
                        invisible="not x_has_associated_service"
                        options="{'no_create_edit': True}"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
